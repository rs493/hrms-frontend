# Browser calls the Spring API (Network tab shows the API host).
# Cookie auth requires credentials + matching CORS allowed origins.
# Auth: JWT is set as HttpOnly cookie HRMS_ACCESS_TOKEN; call GET /api/v1/auth/me for user.
# Local: VITE_API_BASE_URL=http://localhost:8080
# Production: set to your Render API URL.
VITE_API_BASE_URL=http://localhost:8080
